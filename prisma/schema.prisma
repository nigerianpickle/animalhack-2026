datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Report {
  id            String   @id
  rawType       String
  category      String
  date          DateTime
  neighbourhood String
  ward          String?
  lat           Float
  lng           Float

  @@index([neighbourhood])
  @@index([category])
  @@index([date])
  @@map("reports")
}